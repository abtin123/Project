{
  "_note": "Add these layers to the offline MapLibre style (source id = your mbtiles source). Replace text-font with the same font stack your existing labels use.",
  "layers": [
    {"id": "landuse-green", "type": "fill", "source": "abm", "source-layer": "landuse",
     "filter": ["in", ["get", "landuse"], ["literal", ["park", "grass", "forest", "scrub", "pitch"]]],
     "paint": {"fill-color": "#0a5c2c"}},
    {"id": "landuse-other", "type": "fill", "source": "abm", "source-layer": "landuse",
     "filter": ["in", ["get", "landuse"], ["literal", ["commercial", "industrial", "institutional", "transport", "parking", "cemetery", "military"]]],
     "paint": {"fill-color": "#1b1d22"}},
    {"id": "road-service", "type": "line", "source": "abm", "source-layer": "roads", "minzoom": 13,
     "filter": ["in", ["get", "class"], ["literal", ["service", "track", "pedestrian", "busway"]]],
     "layout": {"line-cap": "round", "line-join": "round"},
     "paint": {"line-color": "#6b6f78",
               "line-width": ["interpolate", ["linear"], ["zoom"], 13, 1, 17, 4]}},
    {"id": "road-path", "type": "line", "source": "abm", "source-layer": "roads", "minzoom": 14,
     "filter": ["in", ["get", "class"], ["literal", ["footway", "path", "cycleway", "steps", "bridleway"]]],
     "paint": {"line-color": "#9aa0aa", "line-dasharray": [1, 1.5],
               "line-width": ["interpolate", ["linear"], ["zoom"], 14, 1, 17, 2.5]}},
    {"id": "road-names", "type": "symbol", "source": "abm", "source-layer": "roads", "minzoom": 11,
     "filter": ["has", "name"],
     "layout": {"symbol-placement": "line", "text-field": ["coalesce", ["get", "name_fa"], ["get", "name"]],
                "text-font": ["Vazirmatn Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 17, 14],
                "text-max-angle": 30, "symbol-spacing": 250},
     "paint": {"text-color": "#ffffff", "text-halo-color": "#000000", "text-halo-width": 1.5}}
  ]
}
