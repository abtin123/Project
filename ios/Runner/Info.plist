	<string>Abtin Maps uses your location to show your position and provide navigation.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Abtin Maps uses location during active navigation, including when the app is in the background.</string>
	<key>NSCameraUsageDescription</key>
	<string>Abtin Maps uses the camera for the augmented-reality navigation view.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ir.abtin.abtinMaps</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>abtin</string>
				<string>geo</string>
				<string>google.navigation</string>
			</array>
		</dict>
	</array>
	</dict>
